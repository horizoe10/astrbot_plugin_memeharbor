{
  "require_wake": {
    "description": "需要 @机器人 或唤醒前缀",
    "type": "bool",
    "default": true,
    "hint": "开启时，裸发的命令和快捷斗图都要先 @机器人 或带唤醒前缀；关闭后可直接发「收集 猫」。带 / 的命令不受影响。"
  },
  "case_sensitive": {
    "description": "搜图和快捷斗图区分大小写",
    "type": "bool",
    "default": false
  },
  "library_scope": {
    "description": "图库范围",
    "type": "string",
    "default": "shared",
    "options": [
      "shared",
      "group"
    ],
    "labels": [
      "所有群共用一个图库",
      "每个群使用自己的图库"
    ],
    "subtitles": [
      "在任一群收集的图，各群都能搜到和发送",
      "各群只看到本群收集的图和网页导入的图"
    ],
    "hint": "切换后不会移动或删除任何图片，只改变各群能看到的范围。同一张图被多个群收集时，这些群都能看到。"
  },
  "commands": {
    "description": "触发词别名",
    "type": "list",
    "default": [],
    "hint": "发送触发词时按目标标签斗图，例如「喵」对应「猫」。已有标签不用配置也能直接触发。",
    "items": {
      "type": "object",
      "items": {
        "command": {
          "type": "string",
          "description": "触发词"
        },
        "prefix": {
          "type": "string",
          "description": "目标标签"
        }
      }
    }
  },
  "multi_reply_mode": {
    "description": "快捷斗图发几张",
    "type": "string",
    "default": "random",
    "options": [
      "random",
      "all"
    ],
    "labels": [
      "随机发一张",
      "按上限发多张"
    ],
    "subtitles": [
      "每次从匹配的图中挑一张",
      "数量取「每次最多发送张数」"
    ]
  },
  "max_send_count": {
    "description": "每次最多发送张数",
    "type": "int",
    "default": 3,
    "slider": {
      "min": 1,
      "max": 3,
      "step": 1
    },
    "hint": "一次发多张原图容易触发平台频率限制，建议不超过 3。"
  },
  "recent_window": {
    "description": "防重复：每个群记住最近几次发图",
    "type": "int",
    "default": 10,
    "slider": {
      "min": 1,
      "max": 100,
      "step": 1
    },
    "hint": "随机发图会先避开这些图；可选的图不够时，从最久没发的开始轮换。"
  },
  "send_cooldown": {
    "description": "发图冷却（秒）",
    "type": "int",
    "default": 2,
    "slider": {
      "min": 0,
      "max": 60,
      "step": 1
    },
    "hint": "同一个人在同一会话两次发图之间的最短间隔。"
  },
  "page_size": {
    "description": "群聊预览图每页张数",
    "type": "int",
    "default": 9,
    "slider": {
      "min": 3,
      "max": 12,
      "step": 3
    }
  },
  "max_image_mb": {
    "description": "单张图片大小上限（MB）",
    "type": "int",
    "default": 15,
    "slider": {
      "min": 1,
      "max": 30,
      "step": 1
    }
  },
  "download_timeout": {
    "description": "图片下载超时（秒）",
    "type": "int",
    "default": 20,
    "slider": {
      "min": 5,
      "max": 60,
      "step": 5
    }
  },
  "download_use_proxy": {
    "description": "下载图片时使用 AstrBot 的代理设置",
    "type": "bool",
    "default": true
  },
  "collect_admin_only": {
    "description": "只允许管理员收集图片",
    "type": "bool",
    "default": false
  },
  "allow_owner_manage": {
    "description": "允许收集者管理自己的图片",
    "type": "bool",
    "default": true,
    "hint": "开启后，收集者可以改标签、删除和恢复自己收集的图；没有收集者记录的图只能由管理员管理。"
  },
  "group_whitelist": {
    "description": "只在这些群里使用",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [],
    "_special": "umo",
    "hint": "留空表示所有群。也可以手动填写群号。"
  },
  "group_blacklist": {
    "description": "不在这些群里使用",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [],
    "_special": "umo",
    "hint": "也可以手动填写群号。"
  },
  "user_whitelist": {
    "description": "只允许这些用户使用",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [],
    "_special": "sender_id",
    "hint": "留空表示所有人。"
  },
  "user_blacklist": {
    "description": "不允许这些用户使用",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [],
    "_special": "sender_id"
  },
  "ai_enabled": {
    "description": "开启 AI 识图和 AI 搜图",
    "type": "bool",
    "default": false,
    "hint": "只在主动使用「识图」「AI搜图」时调用模型，可能产生费用；识图会把所选图片发给模型。其他功能都不依赖 AI。"
  },
  "ai_provider_id": {
    "description": "AI 使用的模型",
    "type": "string",
    "default": "",
    "_special": "select_provider",
    "hint": "识图需要支持视觉的模型。群聊中留空时沿用当前会话的模型；网页图库里识图必须选择。"
  },
  "ai_admin_only": {
    "description": "群聊中只有管理员能用 AI",
    "type": "bool",
    "default": true
  }
}
